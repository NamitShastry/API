# ============================================================
# AeroIndex / FareOS — Environment Configuration
# ============================================================
# Copy to .env and fill in values. NEVER commit .env to Git.
# ============================================================

# --- Data Mode ---
# SIMULATED_LIVE | LIVE | HYBRID | REPLAY | BACKTEST
DATA_MODE=SIMULATED_LIVE

# --- Simulator ---
SIM_SEED=20260922
SIMULATION_INTERVAL_SECONDS=2

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aeroindex
POSTGRES_USER=aeroindex
POSTGRES_PASSWORD=changeme_pg_dev_only
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_dev_only
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=aeroindex-raw

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_BYTE_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Password Policy ---
PASSWORD_MIN_LENGTH=12

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=AeroIndex

# --- Celery ---
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# --- Collection ---
COLLECTION_CYCLES_IST=00:30,06:30,12:30,18:30
COLLECTOR_CONCURRENCY=4
COLLECTOR_MAX_PER_HOST_PER_DAY=500
COLLECTOR_DELAY_MIN_S=2
COLLECTOR_DELAY_MAX_S=5

# --- FLASH Engine ---
FLASH_PERSIST_INTERVAL_S=30
FLASH_TICK_MAX_PER_SECOND=4

# --- OFFICIAL Freeze ---
OFFICIAL_FREEZE_TIME_IST=23:30
COVERAGE_MIN_WEIGHT=0.80

# --- Heartbeat ---
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_STALE_THRESHOLD_SECONDS=60
HEARTBEAT_OFFLINE_THRESHOLD_SECONDS=300

# --- Freshness Thresholds ---
FRESHNESS_FRESH_SECONDS=30
FRESHNESS_DEGRADED_SECONDS=120
FRESHNESS_STALE_SECONDS=300

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
RATE_LIMIT_DAILY=50000

# --- Timezone ---
TZ=Asia/Kolkata
